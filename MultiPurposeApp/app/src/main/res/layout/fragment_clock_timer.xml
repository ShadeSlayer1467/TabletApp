<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Timer Display -->
    <TextView
        android:id="@+id/clockTimerTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:text="00:00:000"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Number Pickers Container -->
    <LinearLayout
        android:id="@+id/clockTimerPickerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/clockTimerTextView"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center">
        <!-- Hour Picker -->
        <NumberPicker
            android:id="@+id/clockTimerHourPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clockTimerTextView"
            android:layout_alignParentStart="true"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"/>

        <!-- Minute Picker -->
        <NumberPicker
            android:id="@+id/clockTimerMinutePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clockTimerTextView"
            android:layout_toEndOf="@id/clockTimerHourPicker"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"/>

        <!-- Second Picker -->
        <NumberPicker
            android:id="@+id/clockTimerSecondPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/clockTimerTextView"
            android:layout_toEndOf="@id/clockTimerMinutePicker"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>

    <!-- Start Timer Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/clockTimerStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clockTimerStart"
        android:layout_below="@id/clockTimerPickerLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        app:cornerRadius="8dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Pause Timer Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/clockTimerPause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clockTimerPause"
        android:layout_below="@id/clockTimerStart"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        app:cornerRadius="8dp"
        android:enabled="false"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Reset Timer Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/clockTimerReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/clockTimerReset"
        android:layout_below="@id/clockTimerPause"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        app:cornerRadius="8dp"
        android:enabled="false"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</RelativeLayout>
