<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MultiPurposeApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/Daffodil</item>
        <item name="colorPrimaryVariant">@color/Daffodil</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/HairyHeath</item>
        <item name="colorSecondaryVariant">@color/HairyHeath</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorSecondary</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="DialogStyle" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- Activity Cardview Colors -->
    <color name="ActivityCardviewCardBackground">#333333</color>
    <color name="ActivityCardviewTextColor">#F0F0F0</color>
    <color name="ActivityCardviewBackground">#000000</color>

    <color name="colorWhiteBlack">@color/white</color>

    <color name="colorPrimary">@color/Daffodil</color>
    <color name="colorMid">#c68b2b</color>
    <color name="colorSecondary">@color/HairyHeath</color>
    <color name="colorAccent">@color/Nickel</color>
</resources>